#!/usr/bin/env python3
"""FZ-G1 bezel buttons: short-press / long-press dispatch.

Which bezel buttons actually reach Linux on this tablet (probed 2026-08-15 by
pressing each one and watching all 16 input devices plus the kernel log):

  ROTATION  the only one that reports. It fires AT scancode 0x65 *together
            with* Left Meta - it carries its Windows "Tablet PC Settings ->
            Buttons" assignment in firmware, so the kernel reports KEY_PROG1
            with a modifier held, and anything bound to the bare key never
            matches. It also emits ACPI hotkeys 0x54/0x55 alongside. We read
            the evdev node directly, which keeps it working under a fullscreen
            browser holding keyboard focus.

  A1 / A2   emit NOTHING - no input event, no kernel hotkey, on any device.
            Their Windows assignments were handled by a Panasonic driver that
            does not exist here. Do not spend time binding them without new
            evidence; see BTN2_* below if a second button is ever identified.

Actions live in /etc/fzg1-buttons.conf and are re-read on every press, so
edits take effect without restarting the service.
"""
import glob
import os
import struct
import subprocess
import sys
import threading
import time


def log(msg):
    """Everything lands in journalctl -u fzg1-buttons-daemon.

    Kept deliberately chatty: these buttons reach Linux by two odd routes and
    the only way to tell "press never arrived" from "action failed" is a trace
    of the raw events.
    """
    print(msg, flush=True)

EVENT_FMT = "llHHi"  # struct input_event on 64-bit
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
KEY_PROG1 = 148
CONF = "/etc/fzg1-buttons.conf"
DEFAULTS = {
    "LONG_MS": "600",
    "ROTATION_SHORT": "",
    "ROTATION_LONG": "",
    "BTN2_SHORT": "",
    "BTN2_LONG": "",
    "BTN2_PRESS_HOTKEY": "",
    "BTN2_RELEASE_HOTKEY": "",
}


def load_conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                cfg[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def long_ms(cfg):
    try:
        return int(cfg.get("LONG_MS", 600))
    except ValueError:
        return 600


def desktop_user():
    try:
        who = subprocess.run(["who"], capture_output=True, text=True).stdout
        for line in who.splitlines():
            if ":0" in line or "tty" in line:
                return line.split()[0]
    except Exception:
        pass
    return os.environ.get("AGUSER", "agopenweb")


def run_action(cmd):
    """Run an action inside the logged-in desktop session (we are root)."""
    if not cmd:
        return
    user = desktop_user()
    try:
        uid = subprocess.run(["id", "-u", user], capture_output=True,
                             text=True).stdout.strip() or "1000"
    except Exception:
        uid = "1000"
    env = ("DISPLAY=:0 XAUTHORITY=/home/%s/.Xauthority "
           "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus" % (user, uid))
    log("  run as %s(%s): %s" % (user, uid, cmd))
    subprocess.Popen(["su", user, "-c", "%s %s" % (env, cmd)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def dispatch(button, held_ms):
    cfg = load_conf()
    threshold = long_ms(cfg)
    suffix = "_LONG" if held_ms >= threshold else "_SHORT"
    action = cfg.get(button + suffix, "")
    log("%s held %dms (threshold %dms) -> %s%s = %r"
        % (button, held_ms, threshold, button, suffix, action))
    if not action:
        log("  (no action configured)")
    run_action(action)


def find_keyboard():
    for path in sorted(glob.glob("/dev/input/event*")):
        name_file = "/sys/class/input/%s/device/name" % os.path.basename(path)
        try:
            with open(name_file) as fh:
                if "AT Translated Set 2 keyboard" in fh.read():
                    return path
        except OSError:
            continue
    return None


def watch_rotation():
    """Read KEY_PROG1 press/release straight off the keyboard device."""
    while True:
        dev = find_keyboard()
        if not dev:
            time.sleep(5)
            continue
        log("watching %s for the rotation button (KEY_PROG1)" % dev)
        pressed_at = None
        try:
            with open(dev, "rb") as fh:
                while True:
                    data = fh.read(EVENT_SIZE)
                    if not data:
                        break
                    _s, _us, etype, code, value = struct.unpack(EVENT_FMT, data)
                    if etype != EV_KEY:
                        continue
                    log("key event: code=%d value=%d" % (code, value))
                    if code != KEY_PROG1:
                        continue
                    if value == 1:
                        pressed_at = time.monotonic()
                    elif value == 0:
                        if pressed_at is None:
                            # A release with no press means the button only
                            # reports one edge - treat it as a short tap so it
                            # still does something.
                            log("ROTATION release with no matching press")
                            dispatch("ROTATION", 0)
                        else:
                            held = (time.monotonic() - pressed_at) * 1000
                            pressed_at = None
                            dispatch("ROTATION", held)
        except OSError as exc:
            log("rotation-button watcher error: %s" % exc)
            time.sleep(5)


def watch_btn2():
    """Follow the kernel log for hotkeys the panasonic driver cannot map.

    Reading /dev/kmsg through Python's buffered file object silently reads
    nothing (each record needs its own read() call), so shell out to
    `dmesg --follow` instead. Lines look like:

        [ 7048.402458] Unknown hotkey event: 0x0054

    The bracketed monotonic seconds give microsecond-accurate press timing.
    """
    while True:
        proc = None
        try:
            # --follow-new skips the existing ring buffer; plain --follow would
            # replay history on every restart and re-fire actions from it.
            try:
                proc = subprocess.Popen(["dmesg", "--follow-new"], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True, bufsize=1)
            except OSError:
                proc = subprocess.Popen(["dmesg", "--follow"], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True, bufsize=1)
            pressed_at = None
            for line in proc.stdout:
                if "hotkey" not in line.lower():
                    continue
                stamp = None
                if "[" in line and "]" in line:
                    try:
                        stamp = float(line.split("[", 1)[1].split("]", 1)[0])
                    except ValueError:
                        stamp = None
                log("kernel hotkey: %s" % line.strip())
                cfg = load_conf()
                press = cfg.get("BTN2_PRESS_HOTKEY", "").lower()
                release = cfg.get("BTN2_RELEASE_HOTKEY", "").lower()
                if not press or not release:
                    continue  # A2 unidentified: log only, never act
                low = line.lower()
                if press in low:
                    pressed_at = stamp
                elif release in low and pressed_at is not None and stamp is not None:
                    dispatch("BTN2", (stamp - pressed_at) * 1000.0)
                    pressed_at = None
        except Exception as exc:
            log("A2 watcher error: %s" % exc)
        finally:
            if proc:
                proc.terminate()
        time.sleep(5)


def main():
    threading.Thread(target=watch_btn2, daemon=True).start()
    watch_rotation()


if __name__ == "__main__":
    main()
