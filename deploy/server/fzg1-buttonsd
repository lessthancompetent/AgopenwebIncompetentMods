#!/usr/bin/env python3
"""FZ-G1 bezel buttons: short-press / long-press dispatch.

Three buttons, reaching Linux by two different routes (probed 2026-08-15):

  ROTATION  fires AT scancode 0x65 *together with* Left Meta, because it
            carries its Windows "Tablet PC Settings -> Buttons" assignment in
            firmware. A desktop shortcut bound to the bare key never matches,
            so we read the keyboard's evdev node directly. Needs the hwdb rule
            + setkeycodes (see setup-fzg1.sh) for the key to exist at all.

  A1 / A2   emit nothing on a stock system: the embedded controller queues a
            code into a ring buffer on the \\_SB.TBTN ACPI device (hardware id
            MAT002A) which only its HINF method drains, and no in-tree driver
            claims MAT002A. Fixed by the patched panasonic-hbtn module
            (deploy/server/panasonic-hbtn-fzg1.patch), which turns them into
            KEY_PROG2 / KEY_PROG3 on its own input device.

Reading evdev directly - rather than binding desktop shortcuts - also keeps
the buttons working while a fullscreen browser holds keyboard focus, which is
the normal state in the cab.

Actions live in /etc/fzg1-buttons.conf and are re-read on every press, so
edits apply without restarting the service.
"""
import glob
import os
import struct
import subprocess
import threading
import time

EVENT_FMT = "llHHi"  # struct input_event on 64-bit
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 0x01
CONF = "/etc/fzg1-buttons.conf"

# device name -> {evdev key code: button name used in the config file}
WATCHES = [
    ("AT Translated Set 2 keyboard", {148: "ROTATION"}),          # KEY_PROG1
    ("Panasonic Tablet Button Support", {149: "A1", 202: "A2"}),  # PROG2/PROG3
]

DEFAULTS = {
    "LONG_MS": "1500",
    "A1_SHORT": "", "A1_LONG": "",
    "A2_SHORT": "", "A2_LONG": "",
    "ROTATION_SHORT": "", "ROTATION_LONG": "",
}


def log(msg):
    """Everything lands in journalctl -u fzg1-buttons-daemon.

    Deliberately chatty: it is the only way to tell "press never arrived" from
    "action failed", and a wrong long-press threshold looks exactly like a dead
    button (a 600ms threshold once turned every ordinary press into a long one).
    """
    print(msg, flush=True)


def load_conf():
    cfg = dict(DEFAULTS)
    try:
        with open(CONF) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                cfg[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def desktop_user():
    try:
        who = subprocess.run(["who"], capture_output=True, text=True).stdout
        for line in who.splitlines():
            if ":0" in line or "tty" in line:
                return line.split()[0]
    except Exception:
        pass
    return os.environ.get("AGUSER", "agopenweb")


def run_action(cmd):
    """Run an action inside the logged-in desktop session (we are root)."""
    if not cmd:
        return
    user = desktop_user()
    try:
        uid = subprocess.run(["id", "-u", user], capture_output=True,
                             text=True).stdout.strip() or "1000"
    except Exception:
        uid = "1000"
    env = ("DISPLAY=:0 XAUTHORITY=/home/%s/.Xauthority "
           "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus" % (user, uid))
    log("  run as %s(%s): %s" % (user, uid, cmd))
    subprocess.Popen(["su", user, "-c", "%s %s" % (env, cmd)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def dispatch(button, held_ms):
    cfg = load_conf()
    try:
        threshold = int(cfg.get("LONG_MS", 1500))
    except ValueError:
        threshold = 1500
    suffix = "_LONG" if held_ms >= threshold else "_SHORT"
    action = cfg.get(button + suffix, "")
    log("%s held %dms (threshold %dms) -> %s%s = %r"
        % (button, held_ms, threshold, button, suffix, action))
    if not action:
        log("  (no action configured)")
    run_action(action)


def find_device(name):
    for path in sorted(glob.glob("/dev/input/event*")):
        name_file = "/sys/class/input/%s/device/name" % os.path.basename(path)
        try:
            with open(name_file) as fh:
                if name in fh.read():
                    return path
        except OSError:
            continue
    return None


def watch(dev_name, keymap):
    """Time press->release on one device and dispatch the matching action."""
    while True:
        dev = find_device(dev_name)
        if not dev:
            time.sleep(5)
            continue
        log("watching %s (%s) for %s"
            % (dev, dev_name, ", ".join(sorted(keymap.values()))))
        pressed_at = {}
        try:
            with open(dev, "rb") as fh:
                while True:
                    data = fh.read(EVENT_SIZE)
                    if not data:
                        break
                    _s, _us, etype, code, value = struct.unpack(EVENT_FMT, data)
                    if etype != EV_KEY or code not in keymap:
                        continue
                    button = keymap[code]
                    if value == 1:
                        pressed_at[code] = time.monotonic()
                    elif value == 0:
                        start = pressed_at.pop(code, None)
                        # A release with no press means the button reports only
                        # one edge; treat it as a tap so it still does something.
                        held = (time.monotonic() - start) * 1000 if start else 0
                        dispatch(button, held)
        except OSError as exc:
            log("%s watcher error: %s" % (dev_name, exc))
            time.sleep(5)


def main():
    for dev_name, keymap in WATCHES[1:]:
        threading.Thread(target=watch, args=(dev_name, keymap),
                         daemon=True).start()
    watch(*WATCHES[0])


if __name__ == "__main__":
    main()
