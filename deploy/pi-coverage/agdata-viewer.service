[Unit]
Description=AgOpenWeb coverage map viewer
After=network-online.target agdata-ingest.service
Wants=network-online.target

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /srv/agdata/viewer.py --db /srv/agdata/coverage.db --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
